# Copy this file to `.env` and fill in ONE provider. `.env` is gitignored;
# this template is not, so never put a real key in here.
#
#     cp .env.example .env
#     python -m contextlayer.provider     # verifies the key before a full run
#
# The layer runs with no key at all — it falls back to the deterministic
# classifier and says so in the run's usage file. A key buys back the
# paraphrase tail, not basic function.

# --- Google Gemini -------------------------------------------------------
# Free, no credit card: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# --- Groq ----------------------------------------------------------------
# Free tier, no card: https://console.groq.com -> API Keys
# GROQ_API_KEY=

# --- Anthropic -----------------------------------------------------------
# Paid, prepaid credits: https://console.anthropic.com -> API Keys
# ANTHROPIC_API_KEY=

# --- Ollama --------------------------------------------------------------
# No key needed. Install from https://ollama.com, then `ollama pull qwen2.5:3b`.
# Detected automatically when something is listening on localhost:11434.
# OLLAMA_HOST=http://localhost:11434

# --- Overrides -----------------------------------------------------------
# Force a provider instead of auto-detecting (anthropic|gemini|groq|ollama):
# PROVENANCE_PROVIDER=gemini
#
# Pin a specific model. Prefer a pinned version over a `-latest` alias when
# you care about reproducing a published eval number — an alias can move under
# you between runs, which is why the usage file records the version the
# provider actually served, not the one that was asked for.
# PROVENANCE_MODEL=gemini-flash-latest
